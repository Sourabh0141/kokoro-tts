# =============================================================================
# Kokoro TTS Service - Environment Configuration Template
# =============================================================================
# COPY THIS FILE TO .env AND MODIFY AS NEEDED
#
# This file serves as a template for configuration.
# For production deployment, ensure SERVICE__API_KEY is changed to a secure value.
# =============================================================================

# -----------------------------------------------------------------------------
# Service Configuration
# -----------------------------------------------------------------------------
# Name of the service used in logging and documentation
SERVICE__NAME="Kokoro TTS Service"

# Service version string
SERVICE__VERSION="1.0.0"

# Network host interface to bind to (0.0.0.0 for all interfaces)
SERVICE__HOST="0.0.0.0"

# Port number to listen on
SERVICE__PORT=8004

# Deployment environment (development, production, staging)
SERVICE__ENVIRONMENT="development"

# Security API key for endpoint authentication
# CRITICAL: Change this to a secure random string in production!
SERVICE__API_KEY="dev_api_key"

# Application log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
SERVICE__LOG_LEVEL="INFO"

# Enable auto-reload for development server (set to false in production)
SERVICE__RELOAD=false

# Path for documentation endpoint
SERVICE__DOCS_URL="/docs"

# Path for V1 API prefix
SERVICE__API_V1_PREFIX="/v1/"

# Disable HuggingFace symlink warnings (1=disabled, 0=enabled)
SERVICE__HF_HUB_DISABLE_SYMLINKS_WARNING="1"

# -----------------------------------------------------------------------------
# Model Configuration
# -----------------------------------------------------------------------------
# Hugging Face repository ID for the model
MODEL__REPO_ID="hexgrad/Kokoro-82M"

# Compute device (cpu, cuda, mps)
# Use 'cuda' for NVIDIA GPUs, 'mps' for Mac Silicon, 'cpu' for standard processors
MODEL__DEVICE="cpu"

# Model data type (fp32, fp16, bf16)
# Use 'fp16' or 'bf16' for faster inference if supported by hardware
MODEL__DTYPE="fp32"

# Local directory for model files (relative to project root)
MODEL__LOCAL_MODEL_DIR="models/model"

# Local directory for voice files (relative to project root)
MODEL__LOCAL_VOICES_DIR="models/voices"

# Primary model filename (checked first)
MODEL__FILE_V1="kokoro-v1_0.pth"

# Fallback model filename (checked if v1 not found)
MODEL__FILE_V0_19="kokoro-v0_19.pth"

# -----------------------------------------------------------------------------
# Audio Configuration
# -----------------------------------------------------------------------------
# Audio sample rate in Hz (Standard for Kokoro is 24000)
AUDIO__SAMPLE_RATE=24000

# Output audio format (WAV is standard)
AUDIO__FORMAT="WAV"

# Audio subtype/encoding (PCM_16 is standard 16-bit audio)
AUDIO__SUBTYPE="PCM_16"

# Default filename for downloaded audio
AUDIO__DEFAULT_FILENAME="audio.wav"

# Media type header for audio responses
AUDIO__MEDIA_TYPE="audio/wav"

# -----------------------------------------------------------------------------
# Limits & Constraints
# -----------------------------------------------------------------------------
# Maximum text length in characters (prevents memory exhaustion)
LIMITS__MAX_TEXT_LENGTH=5000

# Minimum text length in characters
LIMITS__MIN_TEXT_LENGTH=1

# Minimum playback speed multiplier
LIMITS__MIN_SPEED=0.5

# Maximum playback speed multiplier
LIMITS__MAX_SPEED=2.0

# Default playback speed multiplier
LIMITS__DEFAULT_SPEED=1.0

# -----------------------------------------------------------------------------
# Cache & Memory Management
# -----------------------------------------------------------------------------
# Time-to-live for loaded voices in seconds (600s = 10 minutes)
# Higher values improve performance but increase memory usage
CACHE__TTL_SECONDS=600

# Interval for checking expired voices in seconds
CACHE__CLEANUP_INTERVAL_SECONDS=5

# Timeout for waiting for cleanup thread to stop during shutdown
CACHE__SHUTDOWN_TIMEOUT_SECONDS=5

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Date format for log messages
LOGGING__DATE_FORMAT="%Y-%m-%d %H:%M:%S"

# Log level for uvicorn access logs
LOGGING__UVICORN_LEVEL="WARNING"

# Log level for transformers library (suppress verbose loading logs)
LOGGING__TRANSFORMERS_LEVEL="WARNING"

# Log level for torch library
LOGGING__TORCH_LEVEL="WARNING"
