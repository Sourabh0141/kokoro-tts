# =============================================================================
# Streamlit Environment Variables (.env.example)
# =============================================================================
#
# This file provides an example of the environment variables needed for the
# Streamlit frontend. Copy this file to .env and fill in the values.
# The .env file is loaded by the application at startup.
#
# -----------------------------------------------------------------------------
# Required Variables
# -----------------------------------------------------------------------------

# --- API Configuration ---
# The base URL of the backend TTS service.
# For local development, this should point to the FastAPI service.
API_BASE_URL=http://127.0.0.1:8880

# The API key for authenticating with the backend.
# This must match the API_KEY set in the backend's .env file.
API_KEY=dev_api_key

# The versioned API prefix for the backend service.
# This should match the api_v1_prefix in the backend's settings.
API_V1_PREFIX=/v1/

# --- UI Configuration ---
# The title of the Streamlit application.
APP_TITLE="Kokoro TTS Playground"

# The icon for the Streamlit application (can be an emoji).
APP_ICON="🔊"

# The page layout mode ("wide" or "centered").
PAGE_LAYOUT="wide"

# The initial state of the sidebar ("expanded" or "collapsed").
SIDEBAR_STATE="expanded"

# The informational text displayed in the sidebar.
ABOUT_TEXT="This is a frontend for the Kokoro TTS service. Select a language and voice, enter your text, and generate high-quality speech."

# The path to the custom CSS file.
STYLE_PATH="src/styles/main.css"

# --- Caching ---
# The cache Time-To-Live (TTL) for the health check in seconds.
HEALTH_CHECK_TTL=60

# The cache TTL for the voice list in seconds.
VOICES_TTL=3600

# --- Text Input ---
# The height of the text input area in pixels.
TEXT_AREA_HEIGHT=150

# The placeholder text for the input area.
TEXT_AREA_PLACEHOLDER="Enter the text you want to convert to speech here..."

# The maximum allowed character length for input text.
MAX_TEXT_LENGTH=5000

# --- Speech Controls ---
# The minimum allowed speech speed.
MIN_SPEED=0.5

# The maximum allowed speech speed.
MAX_SPEED=2.0

# The default speech speed.
DEFAULT_SPEED=1.0

# The step increment for the speed slider.
SPEED_STEP=0.1

# --- Audio Output ---
# The audio format for playback and download.
AUDIO_FORMAT="audio/wav"

# The default filename for downloaded audio files.
DEFAULT_FILENAME="generated_audio.wav"
